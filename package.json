{
  "name": "xp-rover",
  "version": "0.1.1",
  "description": "Rover, the Windows XP search companion dog, animated for any website",
  "keywords": [
    "windows-xp",
    "rover",
    "clippy",
    "mascot",
    "sprite",
    "animation",
    "web-component"
  ],
  "homepage": "https://julioacvd.github.io/rover/",
  "bugs": "https://github.com/JulioAcvd/rover/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JulioAcvd/rover.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "./dist/element.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:lib && pnpm build:demo",
    "build:lib": "node scripts/build-lib.mjs",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.28.6",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "xp.css": "^0.2.6"
  }
}
